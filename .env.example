# Copy to .env for local development. NEVER commit a real .env (it is git-ignored).
#
# The current code does not read any secret at runtime: the app runs with no
# environment variables on Vercel. These are optional / reserved:

# GEMINI_API_KEY: only needed if you later add Gemini features (@google/genai is
# installed but not imported anywhere yet). On Vercel add it under
# Project Settings -> Environment Variables.
GEMINI_API_KEY=""

# PORT: local/Docker server only (default 3000). Ignored on Vercel.
# PORT=3000
